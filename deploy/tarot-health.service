[Unit]
Description=TarotApp production health check
After=network-online.target tarot-app.service nginx.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/health-check-tarot
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

