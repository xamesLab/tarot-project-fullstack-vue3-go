[Unit]
Description=TarotApp MongoDB and uploads backup
After=mongod.service
Requires=mongod.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/backup-tarot
UMask=0077
RuntimeDirectory=tarot-backup
RuntimeDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/tarot-app/uploads
ReadWritePaths=/var/backups/tarot-app
