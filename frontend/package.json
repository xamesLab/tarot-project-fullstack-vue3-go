{
  "name": "nebula-tarot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run --config vite.config.ts",
    "test:deploy": "vitest run --config vite.config.ts --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 --reporter=verbose --logHeapUsage",
    "extract:references": "node scripts/extract-prototypes.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.1.1",
    "@fontsource/cormorant-garamond": "5.1.1",
    "@fontsource/raleway": "5.1.1",
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.62.8",
    "i18next": "24.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "react-i18next": "15.4.0",
    "react-router-dom": "7.18.4",
    "suncalc": "2.0.1",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "postcss": "8.5.31",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
