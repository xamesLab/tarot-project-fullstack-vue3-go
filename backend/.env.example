APP_PORT=8080
APP_ENV=dev
JWT_SECRET=change-me-in-local-env
JWT_TTL=24h
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB_NAME=tarot_daily
MONGO_APP_USER=tarot_daily_app
MONGO_AUTH_SOURCE=tarot_daily
MONGO_URI=mongodb://tarot_daily_app:<set-password>@127.0.0.1:27017/tarot_daily?authSource=tarot_daily
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
MONGO_CONNECT_TIMEOUT=10s
MONGO_PING_TIMEOUT=3s
